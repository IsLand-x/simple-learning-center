# 复制为 .env 后必须填写强密码；留空时 Docker Compose 会拒绝启动。
LEARNING_CENTER_PASSWORD=
LEARNING_CENTER_USERNAME=reader

# 默认只允许从宿主机访问。经 HTTPS 反向代理公开时可改为 0.0.0.0。
LEARNING_CENTER_BIND_ADDRESS=127.0.0.1
LEARNING_CENTER_PORT=4174

# 支持相对路径或绝对路径。书籍、笔记、索引、状态和 API Key 都保存在这里。
LEARNING_CENTER_DATA_DIR=./data

# Linux 可改成 `id -u` 和 `id -g` 的结果，确保挂载目录属于运行容器的用户。
LEARNING_CENTER_UID=1000
LEARNING_CENTER_GID=1000

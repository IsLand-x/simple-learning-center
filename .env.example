# 首次启动默认使用 admin / password。公开部署前务必改成强密码。
LEARNING_CENTER_USERNAME=admin
LEARNING_CENTER_PASSWORD=password

# 默认只允许从宿主机访问。经 HTTPS 反向代理公开时可改为 0.0.0.0。
LEARNING_CENTER_BIND_ADDRESS=127.0.0.1
LEARNING_CENTER_PORT=4174

# 支持相对路径或绝对路径。书籍、笔记、索引、状态和 API Key 都保存在这里。
LEARNING_CENTER_DATA_DIR=./data

# RSS 由服务端错峰定时拉取；默认每 30 分钟一轮，启动 15 秒后安排首轮。
LEARNING_CENTER_RSS_REFRESH_INTERVAL_MS=1800000
LEARNING_CENTER_RSS_REFRESH_INITIAL_DELAY_MS=15000

# 可选：Node 不会自动继承浏览器 VPN。填写服务端可访问的 http/https/socks5 代理 URL。
LEARNING_CENTER_YOUTUBE_PROXY=

# Linux 可改成 `id -u` 和 `id -g` 的结果，确保挂载目录属于运行容器的用户。
LEARNING_CENTER_UID=1000
LEARNING_CENTER_GID=1000

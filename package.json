{
  "name": "learning-center",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:local": "node server/dev.mjs",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/app-icon.svg",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test --test-concurrency=1 server/*.test.mjs",
    "test:web": "vitest run",
    "test:e2e": "playwright test",
    "check:server": "node scripts/check-server-syntax.mjs",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:dead-code": "knip --reporter compact",
    "lint": "eslint src server scripts tests vite.config.ts vitest.config.ts playwright.config.ts --max-warnings 0",
    "format:check": "prettier --check package.json knip.json .prettierrc.json eslint.config.js vitest.config.ts playwright.config.ts scripts server/app server/routes tests src/app src/features src/shared src/store/actions src/store/persistence src/store/defaults.ts src/store/learningState.ts src/store/normalizers.ts src/test \"src/**/*.test.{ts,tsx}\"",
    "build": "npm run check:server && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "verify": "npm run lint && npm run format:check && npm run check:boundaries && npm run check:dead-code && npm test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "preview": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "2.102.0",
    "@douyinfe/semi-ui": "2.102.0",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@hono/node-server": "^2.1.1",
    "@mozilla/readability": "^0.6.0",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@xmldom/xmldom": "^0.8.15",
    "allotment": "^1.20.5",
    "epubjs": "0.3.93",
    "foliate-js": "^1.0.1",
    "hono": "^4.13.5",
    "linkedom": "^0.18.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "^4.0.1",
    "undici": "^7.29.0",
    "youtubei.js": "^18.0.0",
    "zod": "^4.4.3",
    "zustand": "5.0.15"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.8.13"
    },
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "6.35.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}

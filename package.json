{
  "name": "learning-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:local": "node server/dev.mjs",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/app-icon.svg",
    "build": "node --check server/config.mjs && node --check server/storage.mjs && node --check server/apiKeys.mjs && node --check server/app.mjs && node --check server/index.mjs && node --check server/dev.mjs && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@douyinfe/semi-icons": "2.102.0",
    "@douyinfe/semi-ui": "2.102.0",
    "@hono/node-server": "^2.1.1",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "ai": "^7.0.83",
    "allotment": "^1.20.5",
    "epubjs": "0.3.93",
    "foliate-js": "^1.0.1",
    "hono": "^4.13.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.8.2",
    "zod": "^4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "^1.3.0"
  }
}

  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}

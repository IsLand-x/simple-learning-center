{
  "name": "learning-center",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:local": "node server/dev.mjs",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/app-icon.svg",
    "test": "node --test --test-concurrency=1 server/*.test.mjs",
    "build": "node --check server/config.mjs && node --check server/errors.mjs && node --check server/storage.mjs && node --check server/auth.mjs && node --check server/apiKeys.mjs && node --check server/rss.mjs && node --check server/rssArticle.mjs && node --check server/rssScheduler.mjs && node --check server/rssDigestScheduler.mjs && node --check server/youtubeVideo.mjs && node --check server/aiBookSearch.mjs && node --check server/webSearch.mjs && node --check server/aiChat.mjs && node --check server/aiJobs.mjs && node --check server/app.mjs && node --check server/index.mjs && node --check server/dev.mjs && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "verify": "npm test && npm run build",
    "preview": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@douyinfe/semi-icons": "2.102.0",
    "@douyinfe/semi-ui": "2.102.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hono/node-server": "^2.1.1",
    "@mozilla/readability": "^0.6.0",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@xmldom/xmldom": "^0.8.15",
    "ai": "^7.0.83",
    "allotment": "^1.20.5",
    "epubjs": "0.3.93",
    "foliate-js": "^1.0.1",
    "hono": "^4.13.5",
    "linkedom": "^0.18.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "^4.0.1",
    "undici": "^7.29.0",
    "youtubei.js": "^18.0.0",
    "zod": "^4.4.3",
    "zustand": "5.0.15"
  },
  "overrides": {
